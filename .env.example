# Copy to .env and fill in. .env is git-ignored and never enters the container.

# Frontier model APIs — called from the host only.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Local model. Base URL of the Ollama server (host:port, no trailing slash).
OLLAMA_HOST=http://127.0.0.1:11434

# Container runtime binary. podman or docker.
CONTAINER_BIN=podman
